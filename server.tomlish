
// TOML inspired format
// mostly key -> value
// types
// Number               -> 1234
// String               -> "String"
// Bool                 -> true
// Array                -> [1, 2, 3]
// Path                 -> ./path
// Content Path         -> @path (relative to content dir)
// Content Path Folder  -> @path/ (folder)
// Route                -> /path
// Object               -> { key = value, key = value }

[server]
port        = 4000
host        = "127.0.0.1"

[dirs]
content     = ./content
api         = ./api
templates   = @templates
assets      = @assets
generated   = @gen

[structure]
fallback    = /home
error       = @templates/error.html
rss         = @templates/rss.html

[variables]
posts               = @gen/posts/
cool_blogs          = @gen/cool_blogs
quotes              = @gen/quotes_collection
about               = @gen/about.md
random_quote_index  = 0
copyright_start     = 2026
copyright_end       = 2026
domain              = "blockdoth.dev"
gallery             = @assets/gallery/

[static_routes]
/home       = @templates/pages/home.html
/posts      = @templates/pages/posts.html
/quotes     = @templates/pages/quotes.html
/gallery    = @templates/pages/gallery.html
/stats      = @templates/pages/stats.html
/about      = @templates/pages/about.html

// posts is the context var and each post will be bound to post
[dynamic_routes]
/posts = { template = @templates/pages/post.html, context_var = "posts", bind = "post" }
